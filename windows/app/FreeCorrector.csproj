<Project Sdk="Microsoft.NET.Sdk">

  <!-- FreeCorrector for Windows: checks the text fields of any application
       (Outlook, Word, Teams…) with the extension's engines. Build with
       windows/build.ps1, which first builds the engines (dist/web). -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 2004 APIs: the startup task of the Store package (Startup.cs). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WPF and Windows Forms share many type names: no implicit usings. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>FreeCorrector</AssemblyName>
    <RootNamespace>FreeCorrector</RootNamespace>
    <Version>0.3.0</Version>
    <Product>FreeCorrector</Product>
    <Company>BenjiBurn</Company>
    <Copyright>GPL v3 · BenjiBurn</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Drawn from src/icons/icon.svg by tools/make-icon.ps1. -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- The DPI mode stays in app.manifest: the windows are WPF, Windows Forms only gives the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <SatelliteResourceLanguages>fr;en</SatelliteResourceLanguages>
    <!-- The builds handed to users: no debug symbols, so no path of the building
         PC (C:\Users\<account>\…) written into FreeCorrector.dll. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <InteropDir>$(MSBuildProjectDirectory)\obj\interop</InteropDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- Windows' native UI Automation interfaces, converted from the type
         library in UIAutomationCore.dll (tools/make-interop.ps1). -->
    <Reference Include="Interop.UIAutomationClient">
      <HintPath>$(InteropDir)\Interop.UIAutomationClient.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The engines: the online proofreader's build, plus the page that hosts them. -->
    <Content Include="..\..\dist\web\**\*" Exclude="..\..\dist\web\index.html;..\..\dist\web\editor\**;..\..\dist\web\content\**" LinkBase="engine" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="engine\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The settings window shows the extension's options page (tools/settings-page.js). -->
    <Content Include="..\..\src\options\options.css;..\..\src\options\options.js" LinkBase="engine\options" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="obj\settings\settings.html" Link="engine\options\settings.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\icons\icon-32.png" Link="icon-32.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="FcInterop" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(InteropDir)\Interop.UIAutomationClient.dll')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\make-interop.ps1&quot; -Out &quot;$(InteropDir)&quot;" />
  </Target>

  <Target Name="FcEnginesPresent" BeforeTargets="Build" Condition="!Exists('..\..\dist\web\engine\host.js') Or !Exists('obj\settings\settings.html')">
    <Error Text="dist/web ou obj/settings/settings.html est absent : lancer windows/build.ps1 d'abord." />
  </Target>

</Project>
