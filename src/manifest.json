{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.3.0",
  "author": "BenjiBurn",
  "homepage_url": "https://lapigeonnerie.fr/freecorrector",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'"
  },
  "commands": {
    "fix-all": {
      "suggested_key": { "default": "Ctrl+Shift+F", "mac": "MacCtrl+Shift+F" },
      "description": "__MSG_cmdFixAll__"
    },
    "toggle-page": {
      "suggested_key": { "default": "Ctrl+Shift+1", "mac": "MacCtrl+Shift+1" },
      "description": "__MSG_cmdTogglePage__"
    }
  },
  "background": {
    "scripts": [
      "lib/settings.js",
      "lib/i18n.js",
      "lib/menus.js",
      "lib/commands.js",
      "lib/welcome.js",
      "lib/action-icon.js",
      "engine/language.js",
      "engine/host.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/settings.js",
        "lib/i18n.js",
        "content/styles.js",
        "content/field.js",
        "content/rich-field.js",
        "content/docs-field.js",
        "content/ui.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "content/docs-annotate.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "FreeCorrector",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "freecorrector@lapigeonnerie.fr",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "140.0"
    }
  }
}
