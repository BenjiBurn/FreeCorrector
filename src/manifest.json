{
  "manifest_version": 3,
  "name": "FreeCorrector",
  "version": "1.0.0",
  "author": "BenjiBurn",
  "homepage_url": "https://github.com/BenjiBurn/FreeCorrector",
  "description": "Correcteur orthographique et grammatical gratuit pour le français et l’anglais, 100 % local, propulsé par Grammalecte et Harper.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'"
  },
  "background": {
    "scripts": [
      "lib/settings.js",
      "engine/language.js",
      "engine/host.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/settings.js",
        "content/styles.js",
        "content/field.js",
        "content/rich-field.js",
        "content/ui.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "FreeCorrector",
    "default_icon": "icons/icon.svg",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "freecorrector@lapigeonnerie.fr",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
